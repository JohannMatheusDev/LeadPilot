# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Nenhuma variável é obrigatória para subir: sem as do Supabase, a aplicação
# abre em MODO DEMONSTRAÇÃO, com dados fictícios em memória.

# --- Supabase (banco + login) -------------------------------------------
# Project Settings > API (ou "API Keys"). Use a chave PÚBLICA (publishable /
# anon). A service_role NUNCA vai aqui: ela ignora a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Projetos antigos: pode usar NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar da de cima.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mails que podem entrar, separados por vírgula. Vazio = qualquer usuário
# do projeto Supabase. Recomendado preencher.
EMAILS_PERMITIDOS=voce@exemplo.com

# --- Google Places API (New) — só servidor ------------------------------
# Chave restrita à "Places API (New)". Não use prefixo NEXT_PUBLIC_: ela
# não pode chegar ao navegador.
GOOGLE_PLACES_API_KEY=

# Freio de gasto, contado no banco por usuário. Cada busca (20 empresas) e
# cada abertura de lead com vínculo no Google contam 1.
PLACES_LIMITE_POR_MINUTO=10
PLACES_LIMITE_POR_DIA=150

# --- Google Maps JavaScript API — navegador (opcional) ------------------
# OUTRA chave, restrita por referenciador HTTP (seu domínio) e só à
# "Maps JavaScript API". Usada para escolher o centro da busca no mapa.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
